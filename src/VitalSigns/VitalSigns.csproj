<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>VitalSigns</AssemblyName>
    <RootNamespace>VitalSigns</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">D:\Games\Survival Log\Survival Log</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <Interop>$(GameDir)\BepInEx\interop</Interop>
    <ToolkitDll Condition="'$(ToolkitDll)' == ''">D:\devnew\game-mods\SurvivalLog\mods\sl-exiled-toolkit\src\ExiledToolkit\bin\Release\ExiledToolkit.dll</ToolkitDll>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCore)\SemanticVersioning.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(Interop)\HotUpdate.dll" Private="false" />
    <Reference Include="$(Interop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Interop)\Vuplex.WebView.dll" Private="false" />
    <Reference Include="$(ToolkitDll)" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="vitalsigns.js" LogicalName="VitalSigns.vitalsigns.js" />
  </ItemGroup>

  <!-- What the Mod Manager's Mods screen shows about this mod. -->
  <ItemGroup>
    <AssemblyMetadata Include="ModManager.Name" Value="Vital Signs&#10;生命体征" />
    <AssemblyMetadata Include="ModManager.Description" Value="Shows more about your stats on the HUD: each stat's gain multiplier, shading for the losses still to come, the Well Fed lines on the Satiety bar, where the queue will leave each stat, a timer stripe on each buff that ends, buff effects and cures in the hover boxes, the weight you carry, trend arrows and a pulse on buffs about to end. Click a bar to eat, sleep, raise Morale or use Life items, set up in its Actions tab, and click a debuff to cure it. Bars can hide while full, show while exploring and be moved in a layout editor. Also sets how long buffs last, in its Timers tab, and how fast each stat falls and rises.&#10;在屏幕上显示更多属性信息：各项属性的增益倍率、即将扣除量的阴影、「饱腹」条上的「饱腹富余」界线、队列完成后各属性的位置、每个有时限的状态上的计时条、悬停提示里的状态效果与治疗物品、当前负重、趋势箭头，以及即将结束的状态的闪烁提示。点击属性条可以吃东西、睡觉、提升「心情」或使用「生命」物品，在「行动」标签页中设置；点击减益可以治疗。属性条可以在满时隐藏、在探索时显示，并能在布局编辑器中移动。还能设置状态持续多久（在「计时」标签页中）以及每项属性下降和上升的速度。" />
    <AssemblyMetadata Include="ModManager.Author" Value="AnExiledDev" />
    <AssemblyMetadata Include="ModManager.Category" Value="Interface" />
    <AssemblyMetadata Include="ModManager.GameVersion" Value="1.1.20719" />
    <AssemblyMetadata Include="ModManager.Settings" Value="Live" />
    <AssemblyMetadata Include="ModManager.NexusId" Value="133" />
    <AssemblyMetadata Include="ModManager.GitHub" Value="AnExiledDev/SurvivalLog-VitalSigns" />
    <AssemblyMetadata Include="ModManager.Changelog" Value="https://github.com/AnExiledDev/SurvivalLog-VitalSigns/blob/main/CHANGELOG.md" />
  </ItemGroup>

</Project>
